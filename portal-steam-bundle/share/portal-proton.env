# Portal Proton / FEX / DXVK environment (all Windows games via Proton ARM64).
# Sourced by portal-steam, Plasma login, and game wrappers.

# ROCKNIX: Proton games present through XWayland on X11 video driver.
export SDL_VIDEODRIVER=x11
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb

# Ensure Wine/Proton can open a window on KDE (Wayland or X11).
if [[ -z "${DISPLAY:-}" ]]; then
	if [[ -S /tmp/.X11-unix/X0 ]]; then
		export DISPLAY=:0
	elif [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
		export DISPLAY=:0
	fi
fi

# Adreno turnip — DXVK must not pick llvmpipe/software ICD.
if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
	for _icd in \
		/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json \
		/usr/share/vulkan/icd.d/freedreno_icd.json; do
		if [[ -f "${_icd}" ]]; then
			export VK_ICD_FILENAMES="${_icd}"
			break
		fi
	done
fi

# Turnip + DXVK on Adreno (ROCKNIX community patches).
export TU_DEBUG="${TU_DEBUG:-deck_emu}"

# Proton on ARM64 uses FEX for game PE binaries; do not override with box64.
unset MESA_LOADER_DRIVER_OVERRIDE
